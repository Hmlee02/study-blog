---
import Layout from "../layouts/Layout.astro";
import { getProjects, getReports, getWorks } from "../lib/notion-client";

console.log("=== Index Page Rendering Started ===");
const allProjects = await getProjects();
const allReports = await getReports();
const allWorks = await getWorks();
console.log(
  `=== Projects: ${allProjects.length}, Reports: ${allReports.length}, Works: ${allWorks.length} ===`,
);

const projects = allProjects.slice(0, 3);
const reports = allReports.slice(0, 3);
const works = allWorks.slice(0, 6);

function formatDate(dateStr: string): string {
  if (!dateStr) return "";
  const date = new Date(dateStr);
  return `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
}
---

<Layout title="Blog — LHM">
  <!-- Address Bar Style Header -->
  <div class="win95-group-box" style="margin-top: 0;">
    <span class="win95-group-box-label">Blog — lhm</span>
    <div style="padding: 4px;">
      <p style="font-size: 13px; margin: 0;">
        UI/UX 디자이너의 관점에서 UI/UX 기술을 기록합니다.
      </p>
      <p style="font-size: 12px; color: var(--color-text-light); margin: 4px 0 0;">
        Total items: {allProjects.length + allReports.length + allWorks.length}
      </p>
    </div>
  </div>

  <!-- Projects Section -->
  <section id="projects" style="margin-top: 16px;">
    <div class="win95-group-box">
      <span class="win95-group-box-label">&#128194; Projects</span>

      {
        projects.length === 0 ? (
          <div style="padding: 12px; text-align: center;">
            <p>게시된 프로젝트가 없습니다.</p>
          </div>
        ) : (
          <div class="win95-inset" style="margin: 4px 0;">
            <!-- Column Header -->
            <div class="win95-column-header">
              <div class="win95-column-header-item" style="flex-grow: 1;">Name</div>
              <div class="win95-column-header-item" style="width: 100px;">Date</div>
            </div>
            {projects.map((project) => (
              <a href={`/projects/${project.slug}`} class="blog-item">
                <span style="font-size: 14px; flex-shrink: 0;">&#128196;</span>
                <span class="blog-title" style="flex-grow: 1;">{project.title}</span>
                <span class="blog-date" style="text-align: right;">{formatDate(project.date)}</span>
              </a>
            ))}
          </div>
        )
      }

      {
        allProjects.length > 3 && (
          <div style="margin-top: 8px; text-align: right;">
            <a href="/projects" class="win95-button win95-button-sm">
              View All Projects &rarr;
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- Reports Section -->
  <section id="reports" style="margin-top: 16px;">
    <div class="win95-group-box">
      <span class="win95-group-box-label">&#128203; Weekly Reports</span>

      {
        reports.length === 0 ? (
          <div style="padding: 12px; text-align: center;">
            <p>게시된 리포트가 없습니다.</p>
          </div>
        ) : (
          <div class="win95-inset" style="margin: 4px 0;">
            <div class="win95-column-header">
              <div class="win95-column-header-item" style="flex-grow: 1;">Name</div>
            </div>
            {reports.map((report) => (
              <a href={`/reports/${report.slug}`} class="blog-item">
                <span style="font-size: 14px; flex-shrink: 0;">&#128221;</span>
                <span class="blog-title">{report.title}</span>
              </a>
            ))}
          </div>
        )
      }

      {
        allReports.length > 3 && (
          <div style="margin-top: 8px; text-align: right;">
            <a href="/reports" class="win95-button win95-button-sm">
              View All Reports &rarr;
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- 3D Modeling Section (Icon View) -->
  <section id="3d-modeling" style="margin-top: 16px;">
    <div class="win95-group-box">
      <span class="win95-group-box-label">&#127922; 3D Modeling</span>

      {
        works.length === 0 ? (
          <div style="padding: 12px; text-align: center;">
            <p>게시된 작업물이 없습니다.</p>
          </div>
        ) : (
          <div class="gallery-grid">
            {works.map((work) => (
              <a href={`/3d-modeling/${work.slug}`} class="gallery-item">
                <div class="gallery-thumbnail-wrapper">
                  {work.thumbnail ? (
                    <img
                      src={work.thumbnail}
                      alt={work.title}
                      class="gallery-thumbnail"
                      loading="lazy"
                    />
                  ) : (
                    <div class="gallery-placeholder">
                      <span>N/A</span>
                    </div>
                  )}
                </div>
                <div class="gallery-overlay">
                  <span class="gallery-item-title">{work.title}</span>
                </div>
              </a>
            ))}
          </div>
        )
      }

      {
        allWorks.length > 6 && (
          <div style="margin-top: 8px; text-align: right;">
            <a href="/3d-modeling" class="win95-button win95-button-sm">
              View All 3D Modeling &rarr;
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- About Section -->
  <section id="about" style="margin-top: 16px;">
    <div class="win95-group-box">
      <span class="win95-group-box-label">&#9432; About</span>
      <div style="padding: 4px;">
        <p style="margin: 0; line-height: 1.6;">
          저는 UI/UX 디자이너입니다.<br />
          AI를 활용해 넓어지는 UI/UX 디자인을 경험하고, 이것저것 익힌 기술들을 게시합니다.<br />
          아직은 막연한 미래를 향한 기록을 남깁니다.
        </p>
      </div>
    </div>
  </section>
</Layout>
