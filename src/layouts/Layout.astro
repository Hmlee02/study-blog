---
import "../styles/global.css";
import PixelIcon from "../components/PixelIcon.astro";

interface Props {
  title: string;
  description?: string;
  fixedHeight?: boolean;
}

const {
  title,
  description = "UI/UX 디자이너의 기술 블로그",
  fixedHeight = false,
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <!-- Fallback Background -->
    <div
      style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -2; background-color: var(--color-desktop); background-image: var(--desktop-bg-image); background-size: cover; background-position: center; background-repeat: no-repeat;"
    >
    </div>

    <!-- Desktop Background Video -->
    <video
      autoplay
      loop
      muted
      playsinline
      class="video-background"
      id="bg-video"
    >
      <source
        src="/images/desktop-wallpaper.mp4"
        type="video/mp4"
      />
    </video>

    <!-- Win95 Desktop Area -->
    <div
      class:list={[
        "mx-auto max-w-5xl px-2 md:px-4 pt-2",
        fixedHeight ? "" : "pb-12 md:pb-10",
      ]}
      style={fixedHeight
        ? "height: calc(100vh - var(--taskbar-h)); display: flex; flex-direction: column; box-sizing: border-box;"
        : "margin-bottom: 36px;"}
    >
      <!-- Main Window -->
      <div
        class="win95-window"
        style={fixedHeight
          ? "display: flex; flex-direction: column; flex: 1; min-height: 0;"
          : ""}
      >
        <!-- Title Bar -->
        <div class="win95-title-bar" style="flex-shrink: 0;">
          <span class="win95-title-bar-text">
            <PixelIcon name="computer" />
            {title}
          </span>
          <div class="win95-title-buttons">
            <button class="win95-title-btn" aria-label="Minimize">_</button>
            <button class="win95-title-btn" aria-label="Maximize"
              >&#9633;</button
            >
            <button
              class="win95-title-btn win95-title-btn-close"
              aria-label="Close">&#10005;</button
            >
          </div>
        </div>

        <!-- Menu Bar (Desktop Navigation) -->
        <div class="win95-menu-bar desktop-nav" style="flex-shrink: 0;">
          <a href="/" class="win95-menu-item">Home</a>
          <a href="/projects" class="win95-menu-item">Projects</a>
          <a href="/reports" class="win95-menu-item">Reports</a>
          <a href="/3d-modeling" class="win95-menu-item">3D Modeling</a>
          <a href="/#about" class="win95-menu-item">About</a>
        </div>

        <!-- Window Content Area -->
        <div
          style={fixedHeight
            ? "padding: 8px; background: var(--color-bg); flex: 1; min-height: 0; overflow: hidden;"
            : "padding: 8px; background: var(--color-bg);"}
        >
          <slot />
        </div>

        <!-- Status Bar -->
        <div class="win95-status-bar mobile-hidden" style="flex-shrink: 0;">
          <div class="win95-status-section win95-status-section-grow">
            &copy; LHM. 2025. ALL RIGHTS RESERVED.
          </div>
          <div class="win95-status-section">Built with Astro & Notion</div>
        </div>
      </div>
    </div>

    <!-- Win95 Taskbar (Mobile) -->
    <nav class="mobile-tab-bar">
      <!-- Start Button -->
      <a href="/" class="win95-start-btn">
        <svg
          class="win95-start-logo"
          viewBox="0 0 16 16"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect x="1" y="1" width="6" height="6" fill="#FF0000"></rect>
          <rect x="9" y="1" width="6" height="6" fill="#00FF00"></rect>
          <rect x="1" y="9" width="6" height="6" fill="#0000FF"></rect>
          <rect x="9" y="9" width="6" height="6" fill="#FFFF00"></rect>
        </svg>
        Start
      </a>

      <div class="win95-taskbar-divider"></div>

      <!-- Quick Launch Buttons -->
      <a href="/" class="win95-taskbar-btn">
        <PixelIcon name="home" />
        <span class="tab-label">Home</span>
      </a>
      <a href="/projects" class="win95-taskbar-btn">
        <PixelIcon name="folder" />
        <span class="tab-label">Projects</span>
      </a>
      <a href="/reports" class="win95-taskbar-btn">
        <PixelIcon name="clipboard" />
        <span class="tab-label">Reports</span>
      </a>
      <a href="/3d-modeling" class="win95-taskbar-btn">
        <PixelIcon name="cube" />
        <span class="tab-label">3D</span>
      </a>

      <!-- Clock -->
      <div class="win95-tray">
        <span id="win95-clock">00:00</span>
      </div>
    </nav>

    <!-- Win95 Taskbar (Desktop) -->
    <div class="win95-taskbar" style="display: none;">
      <a href="/" class="win95-start-btn">
        <svg
          class="win95-start-logo"
          viewBox="0 0 16 16"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect x="1" y="1" width="6" height="6" fill="#FF0000"></rect>
          <rect x="9" y="1" width="6" height="6" fill="#00FF00"></rect>
          <rect x="1" y="9" width="6" height="6" fill="#0000FF"></rect>
          <rect x="9" y="9" width="6" height="6" fill="#FFFF00"></rect>
        </svg>
        Start
      </a>
      <div class="win95-taskbar-divider"></div>
      <a href="/" class="win95-taskbar-btn win95-taskbar-btn-active">
        <PixelIcon name="computer" />
        {title}
      </a>
      <div class="win95-tray">
        <span id="win95-clock-desktop">00:00</span>
      </div>
    </div>

    <!-- Win95 Start Menu -->
    <div id="start-menu" class="win95-start-menu" style="display: none;">
      <div class="win95-start-menu-sidebar">
        <span class="win95-start-menu-sidebar-text">LHM Blog</span>
      </div>
      <div class="win95-start-menu-items">
        <a href="/" class="win95-start-menu-item">
          <PixelIcon name="home" />
          <span>Home</span>
        </a>
        <a href="/projects" class="win95-start-menu-item">
          <PixelIcon name="folder" />
          <span>Projects</span>
        </a>
        <a href="/reports" class="win95-start-menu-item">
          <PixelIcon name="clipboard" />
          <span>Reports</span>
        </a>
        <a href="/3d-modeling" class="win95-start-menu-item">
          <PixelIcon name="cube" />
          <span>3D Modeling</span>
        </a>
        <div class="win95-start-menu-divider"></div>
        <a href="/#about" class="win95-start-menu-item">
          <PixelIcon name="info" />
          <span>About</span>
        </a>
      </div>
    </div>

    <!-- Win95 Boot Splash -->
    <div id="boot-splash" class="win95-boot-splash">
      <div class="win95-boot-content">
        <div class="win95-boot-logo">
          <svg
            viewBox="0 0 64 64"
            width="64"
            height="64"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect x="4" y="4" width="24" height="24" fill="#FF0000"></rect>
            <rect x="36" y="4" width="24" height="24" fill="#00FF00"></rect>
            <rect x="4" y="36" width="24" height="24" fill="#0000FF"></rect>
            <rect x="36" y="36" width="24" height="24" fill="#FFFF00"></rect>
          </svg>
        </div>
        <div class="win95-boot-text">LHM Blog 95</div>
        <div class="win95-boot-progress">
          <div class="win95-boot-progress-bar"></div>
        </div>
      </div>
    </div>

    <!-- Image Modal (Win95 Window Style) -->
    <div
      id="image-modal"
      class="fixed inset-0 z-[100] hidden items-center justify-center"
      style="background: rgba(135,206,235,0.85);"
      role="dialog"
      aria-modal="true"
    >
      <div
        class="win95-window"
        style="max-width: 90vw; max-height: 90vh; margin: auto;"
      >
        <div class="win95-title-bar">
          <span class="win95-title-bar-text">
            <PixelIcon name="image" />
            Image Viewer
          </span>
          <div class="win95-title-buttons">
            <button
              class="win95-title-btn win95-title-btn-close"
              id="modal-close"
              aria-label="Close">&#10005;</button
            >
          </div>
        </div>
        <div
          style="background: var(--color-window); padding: 2px; border: 2px solid; border-color: var(--color-border-dark) var(--color-border-light) var(--color-border-light) var(--color-border-dark);"
        >
          <img
            id="modal-image"
            src=""
            alt="Full screen view"
            style="max-height: 80vh; max-width: 88vw; object-fit: contain; display: block;"
          />
        </div>
      </div>
    </div>

    <script is:inline>
      // Fallback for Background Video Error
      window.addEventListener("DOMContentLoaded", () => {
        const video = document.getElementById("bg-video");
        if (video) {
          const source = video.querySelector("source");
          if (source) {
            source.addEventListener("error", () => {
              video.style.display = "none";
            });
          }
        }
      });

      // Win95 Clock
      function updateClock() {
        const now = new Date();
        const h = String(now.getHours()).padStart(2, "0");
        const m = String(now.getMinutes()).padStart(2, "0");
        const time = h + ":" + m;
        const el = document.getElementById("win95-clock");
        const elD = document.getElementById("win95-clock-desktop");
        if (el) el.textContent = time;
        if (elD) elD.textContent = time;
      }
      updateClock();
      setInterval(updateClock, 30000);

      // Desktop taskbar visibility
      function updateTaskbar() {
        const desktopTaskbar = document.querySelector(".win95-taskbar[style]");
        if (window.innerWidth >= 768 && desktopTaskbar) {
          desktopTaskbar.style.display = "flex";
        } else if (desktopTaskbar) {
          desktopTaskbar.style.display = "none";
        }
      }
      updateTaskbar();
      window.addEventListener("resize", updateTaskbar);

      // Image Modal
      const modal = document.getElementById("image-modal");
      const modalImg = document.getElementById("modal-image");
      const closeBtn = document.getElementById("modal-close");

      window.openImageModal = (src) => {
        if (!modal || !modalImg) return;
        modalImg.src = src;
        modal.classList.remove("hidden");
        modal.style.display = "flex";
        document.body.style.overflow = "hidden";
      };

      function closeImageModal() {
        if (!modal || !modalImg) return;
        modal.classList.add("hidden");
        modal.style.display = "";
        modalImg.src = "";
        document.body.style.overflow = "";
      }

      closeBtn?.addEventListener("click", closeImageModal);

      modal?.addEventListener("click", (e) => {
        if (e.target === modal) {
          closeImageModal();
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal.classList.contains("hidden")) {
          closeImageModal();
        }
      });

      // ===== Start Menu =====
      const startMenu = document.getElementById("start-menu");
      const startBtns = document.querySelectorAll(".win95-start-btn");

      function toggleStartMenu(e) {
        e.preventDefault();
        e.stopPropagation();
        if (!startMenu) return;
        const isVisible = startMenu.style.display !== "none";
        startMenu.style.display = isVisible ? "none" : "block";
      }

      startBtns.forEach((btn) => {
        btn.addEventListener("click", toggleStartMenu);
      });

      document.addEventListener("click", (e) => {
        if (startMenu && startMenu.style.display !== "none") {
          if (
            !startMenu.contains(e.target) &&
            !e.target.closest(".win95-start-btn")
          ) {
            startMenu.style.display = "none";
          }
        }
      });

      // ===== Boot Splash Animation =====
      const bootSplash = document.getElementById("boot-splash");
      if (bootSplash && !sessionStorage.getItem("win95-booted")) {
        document.body.style.overflow = "hidden";
        bootSplash.style.display = "flex";
        sessionStorage.setItem("win95-booted", "1");
        setTimeout(() => {
          bootSplash.classList.add("win95-boot-fade");
          setTimeout(() => {
            bootSplash.style.display = "none";
            document.body.style.overflow = "";
          }, 500);
        }, 2000);
      } else if (bootSplash) {
        bootSplash.style.display = "none";
      }
    </script>
  </body>
</html>

<style is:global>
  html,
  body {
    background-color: transparent !important;
    background-image: none !important;
  }
  .video-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    object-fit: cover;
    z-index: -1;
    pointer-events: none;
  }
</style>
